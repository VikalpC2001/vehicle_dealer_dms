# PostgreSQL container settings — copied to $DEPLOY_ROOT/shared/postgres.env (chmod 600) by
# scripts/configure-server.sh, which generates the password. SECRET: never commit the real file.
# Read only when the database is FIRST created; changing it later does not change the existing user.
POSTGRES_USER=dcarjt
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dcarjt
# Checksums detect silent disk corruption.
POSTGRES_INITDB_ARGS=--data-checksums
