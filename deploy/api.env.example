# Backend (API) runtime settings — copied to $DEPLOY_ROOT/shared/api.env (chmod 600) by
# scripts/configure-server.sh, which also generates JWT_SECRET and the database password.
# SECRET: never commit the real file. KEY=value, no spaces around "=". A value containing $ must be
# wrapped in single quotes (SMTP_PASS='a$b'): Docker Compose expands $NAME in unquoted values.
# NODE_ENV, PORT, UPLOAD_DIR and LOG_TO_FILES are set by compose.yaml.

# ── Database (the "postgres" service on the internal network) ─────────────────────────────────────
# User, password and database must match postgres.env. connection_limit = pool size of the API.
DATABASE_URL=postgresql://dcarjt:CHANGE_ME@postgres:5432/dcarjt?schema=public&connection_limit=10&pool_timeout=20

# ── Auth ──────────────────────────────────────────────────────────────────────────────────────────
# 64+ random characters: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
JWT_PASSWORD_RESET_EXPIRES_IN=15m
OTP_EXPIRES_MINUTES=15
BCRYPT_SALT_ROUNDS=12
REQUIRE_EMAIL_VERIFIED_FOR_LOGIN=true

# ── Web app origin (CORS, passkeys, e-mail links) ─────────────────────────────────────────────────
ALLOWED_ORIGINS=https://dcarjt.com
FRONTEND_URL=https://dcarjt.com
# Passkeys: the browser's origin is the web app, and its registrable domain is the RP ID.
WEBAUTHN_RP_ID=dcarjt.com
WEBAUTHN_RP_ORIGIN=https://dcarjt.com

# ── Public URLs of uploaded files (served by the API at /uploads) ─────────────────────────────────
BASE_URL=https://api.dcarjt.com
UPLOAD_PUBLIC_URLS_FROM_BASE_URL_ONLY=true
UPLOAD_REPLACE_LOOPBACK_WITH_LAN_IP=false
# The web app (dcarjt.com) and the API (api.dcarjt.com) are the same site.
UPLOAD_CROSS_ORIGIN_RESOURCE_POLICY=same-site
ORPHAN_UPLOAD_RETENTION_HOURS=24

# ── Proxy: exactly one trusted hop (the edge nginx), which sets X-Forwarded-For to the visitor ─────
TRUST_PROXY=1

# ── Google Gemini (document OCR) ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash-lite

# ── E-mail (OTP, invitations, approvals). Port 587 = STARTTLS, 465 = TLS. ─────────────────────────
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM=CHANGE_ME
APP_NAME=E-Dealer

# ── Logging / shutdown ────────────────────────────────────────────────────────────────────────────
# info shows start-up and shutdown; warn shows only problems.
LOG_LEVEL=info
# Must stay below the API's stop_grace_period in compose.yaml (30 s).
SHUTDOWN_TIMEOUT_MS=25000
