# Stack settings — copied to $DEPLOY_ROOT/shared/.env on the server by scripts/configure-server.sh.
# Read by Docker Compose (variable substitution in compose.yaml) and by the deploy scripts.
#
# Rules: KEY=value, one per line, NO quotes, no spaces around "=". Nothing in this file is secret
# (secrets live in api.env and postgres.env). Values marked CHANGE_ME must be set before deploying.

# ── Naming ────────────────────────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=dcarjt
# External Docker volumes holding the data (created once; never removed by the scripts).
POSTGRES_VOLUME=dcarjt_postgres_data
UPLOADS_VOLUME=dcarjt_uploads
# Group id of the deploy user (`id -g`). nginx joins this group to read the TLS key (chmod 640).
# Set automatically by scripts/configure-server.sh.
DEPLOY_GID=CHANGE_ME

# ── Domains (Cloudflare-proxied DNS records pointing at this server) ──────────────────────────────
DOMAIN=dcarjt.com
WWW_DOMAIN=www.dcarjt.com
API_DOMAIN=api.dcarjt.com
# Time zone of the business: dates in exports and "this month" ranges. Stored timestamps stay UTC.
APP_TIMEZONE=Asia/Kolkata

# ── Images (Oracle Cloud Infrastructure Container Registry) ───────────────────────────────────────
# <region-key>.ocir.io, e.g. bom.ocir.io (Mumbai), hyd.ocir.io (Hyderabad).
REGISTRY=CHANGE_ME.ocir.io
# <tenancy-namespace>/<repository-prefix>, e.g. axabcdefghij/dcarjt. Images: .../api, .../api-migrate, .../frontend.
IMAGE_NAMESPACE=CHANGE_ME/dcarjt
# Third-party images are pinned in compose.yaml; override only to roll out a reviewed new version.
# POSTGRES_IMAGE=postgres:18.6-alpine@sha256:...
# NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:...

# ── TLS (paths INSIDE the nginx container; the files live in $DEPLOY_ROOT/shared/certs) ────────────
TLS_CERTIFICATE=/etc/nginx/certs/origin.crt
TLS_CERTIFICATE_KEY=/etc/nginx/certs/origin.key

# ── Edge proxy ────────────────────────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
CLIENT_MAX_BODY_SIZE=12m
PROXY_READ_TIMEOUT=120s
# Per visitor (IPv4 address or IPv6 /64), plus a burst allowance, for requests that try credentials or
# send e-mail: sign-in, sign-up, OTP, password reset, passkey sign-in, self-registration, invitations.
# Not counted: the session heartbeat (/auth/me), token refresh and CORS preflights.
AUTH_RATE_LIMIT=30r/m
AUTH_RATE_BURST=20
# Per visitor, for the unauthenticated file-upload and document-OCR endpoints (/api/v1/upload, /api/v1/ai).
PUBLIC_WRITE_RATE_LIMIT=60r/m
PUBLIC_WRITE_RATE_BURST=40
# 180 days. Raise to 31536000 once HTTPS is known to work everywhere.
HSTS_MAX_AGE=15552000

# ── PostgreSQL tuning (defaults suit a VM with 2–4 GB RAM; see deploy/README.md) ──────────────────
PG_MAX_CONNECTIONS=40
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_SHM_SIZE=256mb
PG_LOG_MIN_DURATION_MS=2000

# ── Container memory limits ───────────────────────────────────────────────────────────────────────
PG_MEMORY_LIMIT=1g
API_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=128m
NGINX_MEMORY_LIMIT=256m

# ── Container logs (Docker json-file rotation, per container) ─────────────────────────────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# ── Deploy behaviour ──────────────────────────────────────────────────────────────────────────────
# Put the previous release back automatically when a deploy fails its health check (database untouched).
AUTO_ROLLBACK=true
# Release directories (and their images) kept for rollback.
RELEASES_TO_KEEP=5

# ── Backups ($DEPLOY_ROOT/shared/backups) ─────────────────────────────────────────────────────────
# Database dumps are kept this many days.
BACKUP_RETENTION_DAYS=14
# Upload archives are full copies of all files: only the newest few stay on this server.
UPLOADS_BACKUPS_TO_KEEP=3
# Optional: encrypt backups with this passphrase file (chmod 600). Leave empty to store them unencrypted.
BACKUP_PASSPHRASE_FILE=
# Optional: a command run after each successful backup to copy it off this server; {dir} is replaced by
# the backup directory. Example (rclone remote "oci" set up for an Object Storage bucket):
#   BACKUP_OFFSITE_COMMAND=rclone copy {dir} oci:dcarjt-backups --max-age 25h
BACKUP_OFFSITE_COMMAND=

# ── Monitoring ────────────────────────────────────────────────────────────────────────────────────
# Optional: a Slack-compatible incoming webhook ({"text": "…"}) for failed health checks, failed deploys and
# failed off-site backups: Slack, Google Chat, Mattermost, or Discord (append /slack to its webhook URL).
ALERT_WEBHOOK_URL=
DISK_WARN_PERCENT=85
