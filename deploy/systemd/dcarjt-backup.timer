# Daily backup at 03:00 India time (quiet hours). Change OnCalendar to move it; then
#   sudo systemctl daemon-reload && systemctl list-timers dcarjt-backup.timer
[Unit]
Description=dcarjt: daily backup

[Timer]
OnCalendar=*-*-* 03:00:00 Asia/Kolkata
RandomizedDelaySec=10min
# Runs at the next boot when the server was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
