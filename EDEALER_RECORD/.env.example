# Application
NODE_ENV=development
PORT=4002
API_PREFIX=/api/v1
# Optional log level (error | warn | info | http | verbose | debug | silly). Default: debug, or warn in production.
# LOG_LEVEL=info
# Production only: also write logs/*.log files. Containers set false and log to stdout (Docker rotates it).
LOG_TO_FILES=true
# On SIGTERM/SIGINT: how long (ms) open requests may finish before the process exits anyway.
SHUTDOWN_TIMEOUT_MS=25000
# Absolute public origin (no trailing slash). Fallback when Host is missing; also used when UPLOAD_PUBLIC_URLS_FROM_BASE_URL_ONLY=true.
BASE_URL=http://localhost:4002
# If true, upload URLs always use BASE_URL. If false (default), use request Host (e.g. LAN IP).
UPLOAD_PUBLIC_URLS_FROM_BASE_URL_ONLY=false
# If true (default), rewrite localhost/127.0.0.1 in upload URLs to this machine's LAN IPv4 (for mobile on same Wi‑Fi).
UPLOAD_REPLACE_LOOPBACK_WITH_LAN_IP=true
# Optional: force that IPv4 (e.g. 192.168.1.10) instead of auto-detection.
# LAN_IPV4_OVERRIDE=
# Express "trust proxy" (client IP, X-Forwarded-Proto / X-Forwarded-Host behind a reverse proxy).
# false (default) = no proxy; a number = how many proxies are in front (production: 1, the edge nginx);
# or a comma-separated list of trusted proxy addresses/subnets. `true` trusts ANY sender — avoid it.
TRUST_PROXY=false
# Cross-Origin-Resource-Policy for /uploads: same-site (default) lets the web app on another
# subdomain of the same site (dcarjt.com → api.dcarjt.com) show uploaded images. same-origin | same-site | cross-origin
UPLOAD_CROSS_ORIGIN_RESOURCE_POLICY=same-site
# Uploaded files directory (under project root)
UPLOAD_DIR=uploads
# Retention (hours) before the background sweep deletes an ORPHANED flat upload file — a bare
# {uuid}.{ext} left in the uploads root, older than this AND not referenced by any DB row.
ORPHAN_UPLOAD_RETENTION_HOURS=24

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/EDEALER_BOOK?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_PASSWORD_RESET_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email OTP (signup + forgot-password); validity window in minutes
OTP_EXPIRES_MINUTES=15

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4002

# Frontend (links in verification / password-reset emails)
FRONTEND_URL=http://localhost:5173

# If true, password and passkey login require emailVerified
REQUIRE_EMAIL_VERIFIED_FOR_LOGIN=true

# Email (optional — if SMTP_HOST is empty, emails are logged only)
# Gmail: use port 587 (STARTTLS) or 465 (SSL). TLS mode is chosen from port; SMTP_SECURE is only used for other ports.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
# Product name shown in emails (header, footer, subjects). Keep it the same as the frontend's VITE_APP_NAME.
APP_NAME=E-Dealer

# WebAuthn / Passkey (RP origin must match the page origin; use http://localhost:5173 if the app is Vite-only)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:4002

# Google Gemini — vision model that extracts RC/ID fields directly from the image.
# A lite model is cheapest; a flash model is more accurate. Thinking is disabled in code.
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite