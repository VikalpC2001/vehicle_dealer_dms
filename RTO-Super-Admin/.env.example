# Dev: use relative URL so Vite proxies /api → backend (no CORS).
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://192.168.0.145:4002

# Production: point directly at API (backend must allow your frontend origin in CORS).
# VITE_API_BASE_URL=http://192.168.0.145:4002/api/v1

VITE_APP_NAME=RTO Super Admin
VITE_TOKEN_KEY=rto_admin_token
VITE_REFRESH_TOKEN_KEY=rto_admin_refresh_token
